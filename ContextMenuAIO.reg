[HKEY_CLASSES_ROOT\*\shell\unblock]
"MUIVerb"="Unblock"

[HKEY_CLASSES_ROOT\*\shell\unblock\Command]
@="powershell.exe Unblock-File '%1'"

[HKEY_CLASSES_ROOT\*\shell\ViewOwner]
"MUIVerb"="View owner"
"Icon"="imageres.dll,-1029"

[HKEY_CLASSES_ROOT\*\shell\ViewOwner\Command]
@="powershell.exe -NoExit Get-ACL '%1'| Format-List -Property Owner"

[HKEY_CLASSES_ROOT\Directory\shell\OpenElevatedPS]
@="Windows PowerShell (Run as Administrator)"
"NoWorkingDirectory"=""
"NeverDefault"=""
"Icon"="PowerShell.exe"

[HKEY_CLASSES_ROOT\Directory\shell\OpenElevatedPS\command]
@="PowerShell.exe -windowstyle hidden -Command \"Start-Process cmd.exe -ArgumentList '/s,/c,pushd %V && powershell' -Verb RunAs\""














